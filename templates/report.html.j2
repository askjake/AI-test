<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ project }} — {{ run_ts | fmt_ts }}</title>
<style>
  :root { --pass:#1a7f37; --fail:#cf222e; --error:#9a6700; --bg:#f6f8fa; --fg:#1f2328; --muted:#656d76; --border:#d0d7de; }
  * { box-sizing: border-box; }
  body { margin:0; font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif; color:var(--fg); background:var(--bg); }
  .wrap { max-width:980px; margin:0 auto; padding:24px 16px 64px; }
  a { color:#0969da; }
  h1 { font-size:22px; margin:0 0 4px; }
  .meta { color:var(--muted); font-size:13px; margin-bottom:16px; }
  .meta code { background:#eaeef2; padding:1px 5px; border-radius:4px; }
  .totals { display:flex; gap:8px; flex-wrap:wrap; margin:16px 0 24px; }
  .stat { background:#fff; border:1px solid var(--border); border-radius:8px; padding:10px 14px; min-width:90px; }
  .stat .n { font-size:22px; font-weight:600; }
  .stat .l { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
  .stat.pass .n { color:var(--pass); } .stat.fail .n { color:var(--fail); } .stat.error .n { color:var(--error); }
  .test { background:#fff; border:1px solid var(--border); border-radius:8px; margin-bottom:16px; overflow:hidden; }
  .test > summary { list-style:none; cursor:pointer; padding:14px 16px; display:flex; align-items:center; gap:10px; }
  .test > summary::-webkit-details-marker { display:none; }
  .test > summary::after { content:"▸"; margin-left:auto; color:var(--muted); }
  .test[open] > summary::after { content:"▾"; }
  .badge { font-size:12px; font-weight:700; text-transform:uppercase; padding:2px 8px; border-radius:999px; color:#fff; }
  .badge.pass { background:var(--pass); } .badge.fail { background:var(--fail); } .badge.error { background:var(--error); }
  .test-title { font-weight:600; }
  .test-target { color:var(--muted); font-size:12px; }
  .body { padding:0 16px 16px; border-top:1px solid var(--border); }
  .section-h { font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); margin:16px 0 8px; }
  .summary-txt { background:var(--bg); border-radius:6px; padding:10px 14px; }
  .summary-txt p, .reasoning p { margin:8px 0; }
  .summary-txt p:first-child, .reasoning p:first-child { margin-top:0; }
  .summary-txt p:last-child, .reasoning p:last-child { margin-bottom:0; }
  .summary-txt ul, .summary-txt ol, .reasoning ul, .reasoning ol { margin:8px 0; padding-left:22px; }
  .summary-txt li, .reasoning li { margin:2px 0; }
  .summary-txt code, .reasoning code { background:#eaeef2; padding:1px 5px; border-radius:4px; font-size:12px; }
  ul.asserts { list-style:none; padding:0; margin:0; }
  ul.asserts li { padding:8px 10px; border:1px solid var(--border); border-radius:6px; margin-bottom:6px; }
  ul.asserts li .mark { font-weight:700; margin-right:6px; }
  ul.asserts li.pass .mark { color:var(--pass); } ul.asserts li.fail .mark { color:var(--fail); }
  ul.asserts li .ev { color:var(--muted); font-size:13px; display:block; margin-top:4px; white-space:pre-wrap; }
  ul.manual-refs { list-style:none; padding:0; margin:0; }
  ul.manual-refs li { padding:6px 10px; border:1px solid var(--border); border-radius:6px; margin-bottom:6px; }
  ul.manual-refs li code { background:#eaeef2; padding:1px 5px; border-radius:4px; font-size:12px; }
  ul.manual-refs li.fail { border-color:var(--fail); }
  ul.manual-refs li .ev { color:var(--fail); font-size:13px; margin-left:6px; }
  .step { border:1px solid var(--border); border-radius:6px; margin-bottom:8px; }
  .step > summary { cursor:pointer; padding:8px 10px; font-size:13px; }
  .step-mark { font-weight:700; margin-left:4px; }
  .step-mark.ok { color:var(--pass); } .step-mark.bad { color:var(--fail); }
  .step .step-body { padding:0 10px 10px; }
  .step-line { margin:8px 0; }
  .step-line .k { display:inline-block; font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); margin-right:6px; }
  .action-row { margin:8px 0; }
  .step .action { font-size:13px; background:var(--bg); padding:6px 8px; border-radius:4px; }
  .action-why { font-size:12px; color:var(--muted); margin:4px 0 0 2px; font-style:italic; }
  .shots { display:flex; flex-wrap:wrap; gap:12px; margin-top:8px; }
  .shot { flex:1 1 320px; min-width:0; }
  .shot .cap { font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px; }
  .step img { max-width:100%; border:1px solid var(--border); border-radius:4px; display:block; cursor:zoom-in; }
  .chart { background:#fff; border:1px solid var(--border); border-radius:6px; padding:8px; overflow-x:auto; }
  .chart svg { max-width:100%; height:auto; display:block; }
  .chart .legend { display:flex; flex-wrap:wrap; gap:12px; margin-top:6px; font-size:12px; color:var(--muted); }
  .chart .legend .lg { display:inline-flex; align-items:center; gap:5px; }
  .chart .legend .sw { width:12px; height:3px; border-radius:2px; display:inline-block; }
  .empty { background:#fff; border:1px dashed var(--border); border-radius:8px; padding:24px; text-align:center; color:var(--muted); }
  .lightbox { display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.8); cursor:zoom-out; align-items:center; justify-content:center; padding:2vh 0; }
  .lightbox.open { display:flex; }
  .lightbox img { width:90vw; max-height:96vh; object-fit:contain; border-radius:4px; box-shadow:0 8px 40px rgba(0,0,0,.5); }
</style>
</head>
<body>
<div class="wrap">
  <p class="meta"><a href="../index.html">← {{ project }} runs</a> · <a href="../../index.html">all projects</a></p>
  <h1>{{ project }}</h1>
  <p class="meta">Run <strong>{{ run_ts | fmt_ts }}</strong> · model <code>{{ model_id }}</code> · {{ duration_seconds }}s</p>

  <div class="totals">
    <div class="stat"><div class="n">{{ total }}</div><div class="l">Assertions</div></div>
    <div class="stat pass"><div class="n">{{ passed }}</div><div class="l">Passed</div></div>
    <div class="stat fail"><div class="n">{{ failed }}</div><div class="l">Failed</div></div>
    <div class="stat error"><div class="n">{{ errored }}</div><div class="l">Errored</div></div>
    <div class="stat"><div class="n">{{ spec_total }}</div><div class="l">Specs</div></div>
  </div>

  {% if session_summary %}
  <div class="section-h">Session summary</div>
  <div class="summary-txt">{{ session_summary | md }}</div>
  {% endif %}

  {% if not tests %}
    <div class="empty">This run contained no tests.</div>
  {% endif %}

  {% set ns = namespace(group=None) %}
  {% for t in tests %}
  {% if t.group and t.group != ns.group %}<div class="section-h group-h">{{ t.group }}</div>{% set ns.group = t.group %}{% endif %}
  <details class="test"{% if t.badge != 'pass' %} open{% endif %}>
    <summary>
      <span class="badge {{ t.badge }}">{{ t.status }}</span>
      <span class="test-title">{{ t.title }}</span>
      <span class="test-target">{{ t.target_type }} · {{ t.step_count }} steps · {{ t.duration_seconds }}s{% if t.spec_href %} · <a href="{{ t.spec_href }}">report</a>{% endif %}</span>
    </summary>
    <div class="body">
      {% if t.error %}
        <div class="section-h">Error</div>
        <div class="summary-txt">{{ t.error }}</div>
      {% endif %}
      {% if t.summary %}
        <div class="section-h">Summary</div>
        <div class="summary-txt">{{ t.summary | md }}</div>
      {% endif %}

      {% if t.manual_pages %}
        <div class="section-h">Manuals referenced</div>
        <ul class="manual-refs">
          {% for p in t.manual_pages %}
          <li{% if not p.ok %} class="fail"{% endif %}><code>{{ p.page }}</code>{% if not p.ok %} <span class="ev">not found</span>{% endif %}</li>
          {% endfor %}
        </ul>
      {% endif %}

      <div class="section-h">Assertions</div>
      {% if t.assertions %}
      <ul class="asserts">
        {% for a in t.assertions %}
        <li class="{{ 'pass' if a.passed else 'fail' }}">
          <span class="mark">{{ '✓' if a.passed else '✗' }}</span>{{ a.text }}
          {% if a.evidence %}<span class="ev">{{ a.evidence }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="test-target">No assertions recorded.</p>
      {% endif %}

      <div class="section-h">Step log ({{ t.steps | length }})</div>
      {% for s in t.steps %}
      <details class="step">
        <summary>Step {{ s.index }}{% if s.instruction %} — {{ s.instruction }}{% endif %}{% if s.success is not none %} <span class="step-mark {{ 'ok' if s.success else 'bad' }}">{{ '✓' if s.success else '✗' }}</span>{% endif %}</summary>
        <div class="step-body">
          {% if s.instruction %}<div class="step-line"><span class="k">Instruction</span> {{ s.instruction }}</div>{% endif %}
          {% if s.rationale %}<div class="step-line"><span class="k">Why</span> {{ s.rationale }}</div>{% endif %}
          {% for a in s.actions %}
          <div class="action-row">
            <div class="action">{{ a.detail }}</div>
            {% if a.reasoning %}<div class="action-why">{{ a.reasoning }}</div>{% endif %}
            {% if a.before_screenshot or a.after_screenshot %}
            <div class="shots">
              {% if a.before_screenshot %}
              <div class="shot">
                <div class="cap">Before</div>
                <img src="{{ a.before_screenshot }}" alt="Step {{ s.index }} before action" loading="lazy">
              </div>
              {% endif %}
              {% if a.after_screenshot %}
              <div class="shot">
                <div class="cap">After</div>
                <img src="{{ a.after_screenshot }}" alt="Step {{ s.index }} after action" loading="lazy">
              </div>
              {% endif %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
          {% if s.outcome %}<div class="step-line"><span class="k">Result</span> {{ s.outcome }}</div>{% endif %}
          {% if s.ending_state %}<div class="step-line"><span class="k">Screen now</span> {{ s.ending_state }}</div>{% endif %}
        </div>
      </details>
      {% else %}
      <p class="test-target">No steps recorded.</p>
      {% endfor %}

      {% if t.planner_charts %}
      <details class="step">
        <summary>Planner context charts</summary>
        <div class="step-body">
          <div class="section-h">Planner context (per step)</div>
          <div class="chart">{{ t.planner_charts.context_svg }}</div>
          <div class="section-h">Cumulative tokens billed vs budget</div>
          <div class="chart">{{ t.planner_charts.cumulative_svg }}</div>
        </div>
      </details>
      {% endif %}
    </div>
  </details>
  {% endfor %}
</div>
<div class="lightbox" id="lightbox"><img alt=""></div>
<script>
(function () {
  var box = document.getElementById("lightbox");
  var full = box.querySelector("img");
  document.addEventListener("click", function (e) {
    var img = e.target;
    if (img.tagName === "IMG" && img.closest(".step")) {
      full.src = img.src;
      full.alt = img.alt;
      box.classList.add("open");
    } else if (box.classList.contains("open")) {
      box.classList.remove("open");
      full.src = "";
    }
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && box.classList.contains("open")) {
      box.classList.remove("open");
      full.src = "";
    }
  });
})();
</script>
</body>
</html>
